# Server Configuration
PORT=
NODE_ENV=
# Client Configuration
CLIENT_URL=
FRONTEND_URL=
# Database Configuration
DB_HOST=
DB_USERNAME=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_DATABASE=

# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=
JWT_REFRESH_SECRET=

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# Email Configuration
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=

# CORS Configuration
CORS_ORIGIN=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=  
RATE_LIMIT_MAX=       

# API Configuration
API_VERSION=
API_PREFIX=

# Security
BCRYPT_ROUNDS=

# Upload Configuration
MAX_FILE_SIZE=  # 5MB in bytes
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/jpg
ALLOWED_RESUME_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Session Configuration
SESSION_CLEANUP_INTERVAL=  

# WebSocket Configuration
WS_PING_INTERVAL=
WS_PING_TIMEOUT=

# Logging
LOG_LEVEL=debug

# Cookie Settings
COOKIE_DOMAIN=localhost


# Email Configuration
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=

RESEND_API_KEY=
EMAIL_FROM=

# .env
GEMINI_API_KEY=

CLAUDE_API_BASE_URL=
CLAUDE_API_KEY=

RABBITMQ_URL=

## Setup action secret and variable
SUPABASE_URL=
SUPABASE_ANON_KEY=
RENDER_HEALTH_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

REDIS_URL=
REDIS_TLS=false

# ── Observability & resilience (tất cả tuỳ chọn) ─────────────────────────────
# Ngưỡng log WARN "Slow query" (ms). Mặc định 500.
DB_SLOW_QUERY_MS=
# Cảnh báo request chạy >= N câu SQL, hoặc 1 câu SQL lặp >= N lần (nghi N+1).
DB_QUERY_COUNT_WARN=
N_PLUS_ONE_THRESHOLD=
# Đặt để yêu cầu Prometheus gửi "Authorization: Bearer <token>" khi scrape /metrics.
METRICS_TOKEN=
# Error tracking. Không đặt DSN = tắt hoàn toàn.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_RELEASE=
# Timeout gọi dịch vụ ngoài (ms).
CLOUDINARY_TIMEOUT_MS=
EMAIL_TIMEOUT_MS=


OUTBOX_POLL_MS=
OUTBOX_BATCH_SIZE=
# Quá số lần thử này event bị đánh dấu dead (xem metric jobportal_outbox_dead).
OUTBOX_MAX_ATTEMPTS=
OUTBOX_RETENTION_DAYS=

# ── Distributed tracing (OpenTelemetry) — đặt endpoint để bật ───────────────
# Khi bật, Sentry chỉ còn bắt lỗi (không dựng TracerProvider thứ 2).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Tuỳ chọn (chuẩn OTel): lấy mẫu trace. Mặc định production 10% (0.1), dev 100%.
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# Backend có xác thực (vd Grafana Cloud): OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic <base64>"
OTEL_EXPORTER_OTLP_HEADERS=

# ── Tài liệu API (OpenAPI / Swagger UI tại /docs) ───────────────────────────
# Mặc định BẬT ở dev, TẮT ở production. Bật ở production thì NÊN đặt DOCS_BASIC_AUTH.
DOCS_ENABLED=
# Dạng user:pass — trình duyệt sẽ hỏi đăng nhập khi mở /docs
DOCS_BASIC_AUTH=
# Origin công khai của API (vd https://api.devyro.com) → servers[0].url trong spec
API_PUBLIC_URL=
OTEL_SERVICE_NAME=