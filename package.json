{
  "name": "job-portal-backend",
  "version": "1.0.0",
  "description": "Job Portal Backend with TypeScript, Express, and PostgreSQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development CHOKIDAR_USEPOLLING=true ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "prebuild": "rimraf dist",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "start:dev": "cross-env NODE_ENV=development ts-node src/server.ts",
    "typecheck": "tsc --noEmit",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate -d src/config/database.config.ts",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run": "npm run typeorm -- migration:run -d src/config/database.config.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/config/database.config.ts",
    "migration:show": "npm run typeorm -- migration:show -d src/config/database.config.ts",
    "migration:run:prod": "cross-env NODE_ENV=production DB_STATEMENT_TIMEOUT_MS=300000 typeorm migration:run -d dist/config/database.config.js",
    "start:render": "npm run migration:run:prod && npm start"
  },
  "ts-node": {
    "transpileOnly": true,
    "esm": false,
    "compilerOptions": {
      "module": "CommonJS",
      "moduleResolution": "node"
    }
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "amqplib": "^1.0.3",
    "axios": "^1.13.5",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cloudinary": "^1.41.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-prom-bundle": "^8.0.0",
    "express-rate-limit": "^8.2.1",
    "he": "^1.2.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "9.0.2",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.13",
    "pdf-parse": "^1.1.4",
    "pg": "^8.11.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.1.13",
    "slugify": "^1.6.8",
    "socket.io": "^4.8.3",
    "streamifier": "^0.1.1",
    "typeorm": "^0.3.17",
    "winston": "^3.19.0",
    "zod": "^4.3.5",
    "cross-env": "^10.1.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.16",
    "@types/express": "^4.17.25",
    "@types/he": "^1.2.3",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.9",
    "@types/pdf-parse": "^1.1.5",
    "nodemon": "^3.0.1",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.0"
  }
}
